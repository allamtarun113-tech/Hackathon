# ----------------------------------------------------------------------------
# PagerMind configuration for both the backend and the frontend.
# Copy to .env at the repository root and fill in the blanks.
# Backend secrets stay on the server; only NEXT_PUBLIC_* values reach the browser.
# ----------------------------------------------------------------------------

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed by CORS (the deployed Vercel URL in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase
# Postgres connection string. Use the Supabase *Session* pooler (port 5432), not the Transaction pooler
# (6543): connections set statement_timeout / application_name at startup, which transaction mode rejects.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Hindsight
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=pagermind-incidents
# Shared secret configured on the Hindsight webhook; used to verify signatures.
HINDSIGHT_WEBHOOK_SECRET=
# Public URL Hindsight should deliver webhooks to, e.g. https://pagermind-api.onrender.com/webhooks/hindsight
HINDSIGHT_WEBHOOK_URL=

# Groq
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Write boundary. A long random string held by the operator running the demo; required by
# POST /incidents/{id}/resolve, POST /feedback/{id}/review, GET /conversations and GET /incidents.
# Leave empty to disable those endpoints.
OPERATOR_TOKEN=
# Reverse proxies in front of the API that append to X-Forwarded-For (Render = 1, local = 0).
TRUSTED_PROXY_HOPS=0

# Capacity and timeouts (defaults shown). Keep
#   api_instances * DATABASE_POOL_MAX_SIZE + WORKER_DATABASE_POOL_MAX_SIZE
# below the Supabase pooler's connection limit, and MAX_CONCURRENT_AGENT_RUNS below DATABASE_POOL_MAX_SIZE.
DATABASE_POOL_MAX_SIZE=10
WORKER_DATABASE_POOL_MAX_SIZE=4
DATABASE_STATEMENT_TIMEOUT_MS=15000
MAX_CONCURRENT_AGENT_RUNS=6
RATE_LIMIT_PER_MINUTE=30

# Retention of operational telemetry (days). Incidents, conversations, feedback and audit are kept.
RETENTION_WEBHOOK_DAYS=14
RETENTION_HEALTH_SNAPSHOT_DAYS=30
RETENTION_GUARDRAIL_RESULT_DAYS=90

# ----------------------------------------------------------------------------
# Frontend (Next.js). NEXT_PUBLIC_* values are embedded in the browser bundle:
# public values only.
# ----------------------------------------------------------------------------
# The FastAPI backend URL - no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Sentry browser DSN (a DSN is a public ingest key, not a credential).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development

# Build-time only (source map upload), never prefixed with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
